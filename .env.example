# ============================================================================
#  APHELIOS — Beispiel-Konfiguration
#  Kopiere diese Datei nach `.env` und trage deine Werte ein.
#  Ohne API-Key läuft APHELIOS im Fallback-Modus (lokale Standardantworten).
# ============================================================================

# ---- AI Provider -----------------------------------------------------------
# Primärer Provider: "anthropic" (empfohlen), "openai" oder "ollama"
APHELIOS_AI_PROVIDER=anthropic

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
APHELIOS_ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI (Fallback) — optional
OPENAI_API_KEY=
APHELIOS_OPENAI_MODEL=gpt-4o

# Ollama (lokaler Fallback) — optional
APHELIOS_OLLAMA_HOST=http://localhost:11434
APHELIOS_OLLAMA_MODEL=llama3.1

# ---- Memory / Second Brain -------------------------------------------------
# Pfad zum Obsidian-Vault (wird bei Bedarf erstellt, inkl. Unterordner).
# Öffne denselben Ordner in Obsidian als Vault, dann zeigt der eingebaute
# Graph View automatisch, wie APHELIOS deine Notizen verlinkt hat.
# Windows-Beispiel (Nutzernamen anpassen!):
#   APHELIOS_VAULT_PATH=C:\Users\<DeinBenutzername>\Documents\Obsidian\Aphelios
APHELIOS_VAULT_PATH=./vault
# SQLite-Index für schnelle Wiederfindung
APHELIOS_DB_PATH=./data/aphelios.sqlite

# ---- System-Monitoring -----------------------------------------------------
# Intervall (Sekunden) für System-Statistiken
APHELIOS_STATS_INTERVAL=2.0

# ---- Wetter (Open-Meteo — kostenlos, kein API-Key nötig) -------------------
APHELIOS_WEATHER_CITY=Berlin
# Intervall (Sekunden) zwischen Wetter-Abrufen
APHELIOS_WEATHER_INTERVAL=900

# ---- Gmail & Google Kalender — braucht eigenen OAuth-Client! ---------------
# Einrichtung: docs/integrations.md, Abschnitt "Gmail & Kalender einrichten".
# Ohne diese Werte bleiben Mail-/Kalender-Panel bei Mock-Daten (kein Fehler).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APHELIOS_GOOGLE_TOKEN_PATH=./data/google_token.json
APHELIOS_GOOGLE_POLL_INTERVAL=300

# ---- Aktien — Trading-Dashboard + Chat-Werkzeug, kein API-Key nötig -------
# Öffentlicher Yahoo-Finance-Chart-Endpunkt (kein Key, kein Vertrag nötig).
# Watchlist für das Dashboard – Ad-hoc-Anfragen ("/aktie <Symbol>", Claude-
# Werkzeug) funktionieren unabhängig davon für JEDES Symbol.
APHELIOS_STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA
APHELIOS_STOCK_POLL_INTERVAL=60
# Investment-Committee-Analyse ("/aktien-analyse <Symbol>") läuft NUR auf
# Zuruf, kein automatischer Hintergrund-Lauf – braucht ANTHROPIC_API_KEY.

# ---- Spotify — Musik-Steuerung (Play/Pause/Skip/Lautstärke), optional ------
# Einrichtung: docs/integrations.md, Abschnitt "Spotify einrichten".
# Ohne diese Werte bleibt das Musik-Panel bei Vorschau-Daten (kein Fehler).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APHELIOS_SPOTIFY_TOKEN_PATH=./data/spotify_token.json
# Intervall (Sekunden) für den aktuellen Song – 15s schont Spotifys
# Anfrage-Kontingent (429 QUOTA_EXCEEDED bei zu häufigem Polling); das
# Musik-Panel interpoliert Fortschritt/Ring clientseitig dazwischen weiter.
APHELIOS_SPOTIFY_POLL_INTERVAL=15.0

# ---- Sprache — Piper-TTS + faster-whisper-STT, beide optional --------------
# Einrichtung: docs/voice.md. Ohne Piper-Modell fällt die Sprachausgabe
# automatisch auf die (robotischere) Browser-Stimme zurück – kein Fehler.
# Windows-Beispiel (Nutzernamen anpassen!):
#   APHELIOS_PIPER_MODEL_PATH=C:\Users\<DeinBenutzername>\Aphelios\voices\de_DE-thorsten-medium.onnx
APHELIOS_PIPER_MODEL_PATH=
# Whisper-Modellgröße: tiny/base/small/medium/large-v3 (lädt automatisch)
APHELIOS_WHISPER_MODEL=base
APHELIOS_WHISPER_DEVICE=cpu

# ---- Vision — Screenshot + OCR, optional ------------------------------------
# Einrichtung: docs/vision.md. /sieh nutzt bei vorhandenem ANTHROPIC_API_KEY
# echte Bildanalyse (Claude Vision); /lies und /fehler brauchen zusätzlich
# das tesseract-Kommandozeilenprogramm im PATH (kein reines Python-Paket).
# Tesseract-Sprachpakete (müssen installiert sein, z. B. "deu"+"eng"):
APHELIOS_OCR_LANG=deu+eng

# ---- Browser — Webseiten lesen (/browse), optional --------------------------
# Einrichtung: docs/browser.md ("pip install -e '.[browser]'" danach
# "playwright install chromium"). true = unsichtbar (Standard, sicher für
# Server/CI); false = sichtbares Browser-Fenster auf dem eigenen Desktop.
APHELIOS_BROWSER_HEADLESS=true

# ---- Office — Word/Excel/PowerPoint/PDF lesen (/dokument), optional --------
# Einrichtung: docs/office.md ("pip install -e '.[office]'"). Keine eigene
# .env-Variable nötig — nutzt denselben ANTHROPIC_API_KEY wie die AI-Konsole.

# ---- API-Server ------------------------------------------------------------
APHELIOS_API_HOST=127.0.0.1
APHELIOS_API_PORT=8787
# Erlaubter Frontend-Origin (Vite Dev-Server)
APHELIOS_CORS_ORIGIN=http://localhost:5173

# ---- Verhalten -------------------------------------------------------------
# Log-Level: DEBUG | INFO | WARNING | ERROR
APHELIOS_LOG_LEVEL=INFO
